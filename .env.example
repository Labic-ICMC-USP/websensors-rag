# Copie para .env e preencha localmente (chmod 600). Não versione valores reais.
# Arquivo único de segredos: lido pelo loader do RAG (${VAR} no YAML),
# pelo Docker Compose do MinIO e por scripts/minio-init.sh.

# OpenRouter: embeddings e LLM (api_key: "${OPENROUTER_API_KEY}" no YAML).
OPENROUTER_API_KEY=

# Autenticação da API RAG e integração do extrator/Tool OpenWebUI.
RAG_API_TOKEN=

# MinIO AIStor. Use segredos aleatórios, sem espaços (ex.: python -c "import secrets;print(secrets.token_hex(32))").
MINIO_IMAGE=quay.io/minio/aistor/minio:latest
MINIO_ROOT_USER=rag-admin
MINIO_ROOT_PASSWORD=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO
RAG_MINIO_ACCESS_KEY=websensors-rag
RAG_MINIO_SECRET_KEY=SUBSTITUA_POR_OUTRO_SEGREDO_ALEATORIO
